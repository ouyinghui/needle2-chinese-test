[
  {
    "name": "turn_on_light",
    "description": "打开或调节指定房间的灯光。示例: '客厅灯开到50%' -> room='客厅', brightness=50",
    "parameters": {
      "type": "object",
      "properties": {
        "room": {"type": "string", "description": "房间名称，如 '客厅', '卧室'"},
        "brightness": {"type": "integer", "minimum": 0, "maximum": 100, "description": "亮度值 0-100。0=关灯"}
      },
      "required": ["room", "brightness"]
    }
  },
  {
    "name": "set_thermostat",
    "description": "设置空调温度。示例: '空调调到26度' -> temperature=26",
    "parameters": {
      "type": "object",
      "properties": {
        "temperature": {"type": "number", "description": "目标温度 (°C)"},
        "mode": {"type": "string", "enum": ["cool", "heat", "auto"], "description": "运行模式: 制冷/制热/自动"}
      },
      "required": ["temperature"]
    }
  }
]
